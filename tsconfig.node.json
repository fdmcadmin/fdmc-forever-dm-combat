{
  "compilerOptions": {
    "composite": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowSyntheticDefaultImports": true,
    "target": "ES2022",
    "lib": [
      "ES2022"
    ],
    "skipLibCheck": true,
    "outDir": "./node_modules/.tmp/vite-config"
  },
  "include": [
    "vite.config.ts"
  ]
}
