# Dependencies
node_modules/

# Build output — deploy dist/ to Cloudflare manually, don't track in git
dist/

# Private actor source files — campaign character data, not for sharing
src/private/
# Private actor export — real party data, never publish to the repo
fdmc-actor-library-export.json

# Local env / secrets
.env
.env.local
.env.*.local

# Editor
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# OS
.DS_Store
Thumbs.db

# TypeScript cache
*.tsbuildinfo

# Emitted by "tsc -b" from tsconfig.node.json (composite, so it emits). Vite itself reads
# vite.config.ts, so these are build output that used to be tracked - and they reappeared as a
# dirty working tree after every single build.
vite.config.js
vite.config.d.ts

# Local dev scripts
push.bat

# Logs
*.log
npm-debug.log*

# Design/method documents — Christopher's, NOT the app's.
# MASTER, the phase specs, the balance rules and the build log describe HOW this was
# built. They live one level up in candidates/0.6.0-clean-rebuild/_specs/ and must stay
# out of the repository: shipping the method alongside the product gives it away.
_specs/
