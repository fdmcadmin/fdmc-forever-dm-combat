# Normalize line endings — LF in repo, platform-native on checkout
* text=auto eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.json text eol=lf
*.html text eol=lf
*.css text eol=lf
*.md text eol=lf

# Binary — no line ending conversion
*.png binary
*.jpg binary
*.ico binary
*.svg text eol=lf
